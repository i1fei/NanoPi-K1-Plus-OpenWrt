+static u32 rtw_assoc_timeout_remaining_ms(systime deadline)
+{
+	systime now = rtw_get_current_time();
+	u32 timeout_ms;
+
+	if (!rtw_time_before(now, deadline))
+		return 1;
+
+	timeout_ms = rtw_systime_to_ms(deadline - now);
+	return timeout_ms ? timeout_ms : 1;
+}
+
+void rtw_assoc_timeout_arm_locked(struct mlme_priv *pmlmepriv, u32 timeout_ms)
+{
+	struct rtw_assoc_timeout *timeout = &pmlmepriv->assoc_timeout;
+	systime deadline = rtw_get_current_time() + rtw_ms_to_systime(timeout_ms);
+
+	if (!timeout->initialized
+	    || timeout->state == RTW_ASSOC_TIMEOUT_SHUTDOWN) {
+		rtw_warn_on(1);
+		return;
+	}
+
+	if (timeout->state == RTW_ASSOC_TIMEOUT_DRAINING) {
+		timeout->pending = _TRUE;
+		timeout->pending_deadline = deadline;
+		return;
+	}
+
+	timeout->state = RTW_ASSOC_TIMEOUT_ARMED;
+	timeout->deadline = deadline;
+	timeout->pending = _FALSE;
+	_set_timer(&timeout->timer, timeout_ms);
+}
+
+void rtw_assoc_timeout_arm(struct mlme_priv *pmlmepriv, u32 timeout_ms)
+{
+	_irqL irqL;
+
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+	rtw_assoc_timeout_arm_locked(pmlmepriv, timeout_ms);
+	_exit_critical_bh(&pmlmepriv->lock, &irqL);
+}
+
+u8 rtw_assoc_timeout_cancel_locked(struct mlme_priv *pmlmepriv)
+{
+	struct rtw_assoc_timeout *timeout = &pmlmepriv->assoc_timeout;
+	u8 removed = _FALSE;
+
+	if (!timeout->initialized)
+		return removed;
+
+	switch (timeout->state) {
+	case RTW_ASSOC_TIMEOUT_ARMED:
+		timeout->state = RTW_ASSOC_TIMEOUT_IDLE;
+		timeout->deadline = 0;
+		removed = _cancel_timer_nosync(&timeout->timer);
+		break;
+	case RTW_ASSOC_TIMEOUT_DRAINING:
+		/* The drain thread owns the timer; discard only a deferred arm. */
+		timeout->pending = _FALSE;
+		timeout->pending_deadline = 0;
+		break;
+	default:
+		break;
+	}
+
+	return removed;
+}
+
+void rtw_assoc_timeout_drain(struct mlme_priv *pmlmepriv)
+{
+	struct rtw_assoc_timeout *timeout = &pmlmepriv->assoc_timeout;
+	_irqL irqL;
+	u8 removed;
+
+	if (!timeout->initialized)
+		return;
+
+	_enter_critical_mutex_lock(&timeout->drain_mutex, NULL);
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+	if (timeout->state == RTW_ASSOC_TIMEOUT_SHUTDOWN) {
+		_exit_critical_bh(&pmlmepriv->lock, &irqL);
+		_exit_critical_mutex(&timeout->drain_mutex, NULL);
+		return;
+	}
+	timeout->state = RTW_ASSOC_TIMEOUT_DRAINING;
+	timeout->deadline = 0;
+	timeout->pending = _FALSE;
+	timeout->pending_deadline = 0;
+	removed = _cancel_timer_nosync(&timeout->timer);
+	_exit_critical_bh(&pmlmepriv->lock, &irqL);
+
+	RTW_DBG("%s: pending before drain=%u\n", __func__, removed);
+	_cancel_timer_ex(&timeout->timer);
+
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+	if (timeout->state == RTW_ASSOC_TIMEOUT_DRAINING) {
+		if (timeout->pending) {
+			timeout->deadline = timeout->pending_deadline;
+			timeout->pending = _FALSE;
+			timeout->pending_deadline = 0;
+			timeout->state = RTW_ASSOC_TIMEOUT_ARMED;
+			_set_timer(&timeout->timer,
+				rtw_assoc_timeout_remaining_ms(timeout->deadline));
+		} else {
+			timeout->state = RTW_ASSOC_TIMEOUT_IDLE;
+		}
+	}
+	_exit_critical_bh(&pmlmepriv->lock, &irqL);
+	_exit_critical_mutex(&timeout->drain_mutex, NULL);
+}
+
+void rtw_assoc_timeout_shutdown(struct mlme_priv *pmlmepriv)
+{
+	struct rtw_assoc_timeout *timeout = &pmlmepriv->assoc_timeout;
+	_irqL irqL;
+
+	if (!timeout->initialized)
+		return;
+
+	_enter_critical_mutex_lock(&timeout->drain_mutex, NULL);
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+	timeout->state = RTW_ASSOC_TIMEOUT_SHUTDOWN;
+	timeout->deadline = 0;
+	timeout->pending = _FALSE;
+	timeout->pending_deadline = 0;
+	_exit_critical_bh(&pmlmepriv->lock, &irqL);
+
+	_shutdown_timer(&timeout->timer);
+	_exit_critical_mutex(&timeout->drain_mutex, NULL);
+}
+
+void rtw_assoc_timeout_deinit(struct mlme_priv *pmlmepriv)
+{
+	struct rtw_assoc_timeout *timeout = &pmlmepriv->assoc_timeout;
+
+	if (!timeout->initialized)
+		return;
+
+	rtw_assoc_timeout_shutdown(pmlmepriv);
+	_rtw_mutex_free(&timeout->drain_mutex);
+	timeout->initialized = _FALSE;
+}
