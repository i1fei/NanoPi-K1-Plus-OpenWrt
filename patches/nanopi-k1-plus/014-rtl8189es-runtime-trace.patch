diff --git a/os_dep/linux/sdio_ops_linux.c b/os_dep/linux/sdio_ops_linux.c
index ca50608..e42b311 100644
--- a/os_dep/linux/sdio_ops_linux.c
+++ b/os_dep/linux/sdio_ops_linux.c
@@ -34,6 +34,29 @@ static bool rtw_sdio_claim_host_needed(struct sdio_func *func)
 	return _TRUE;
 }
 
+static systime rtw_sdio_claim_host_timed(struct sdio_func *func, const char *tag)
+{
+	systime request = rtw_get_current_time();
+	u32 wait_ms;
+
+	sdio_claim_host(func);
+	wait_ms = rtw_get_passing_time_ms(request);
+	if (wait_ms > 5) {
+		RTW_INFO("RTW_SDIO_CLAIM: request tag=%s\n", tag);
+		RTW_INFO("RTW_SDIO_CLAIM: acquired tag=%s wait_ms=%u\n", tag, wait_ms);
+	}
+	return request;
+}
+
+static void rtw_sdio_release_host_timed(struct sdio_func *func, systime request, const char *tag)
+{
+	u32 held_ms = rtw_get_passing_time_ms(request);
+
+	sdio_release_host(func);
+	if (held_ms > 5)
+		RTW_INFO("RTW_SDIO_CLAIM: released tag=%s held_ms=%u\n", tag, held_ms);
+}
+
