+	return timer_delete(&ptimer->timer) == 1;
+#else
+	return del_timer(&ptimer->timer) == 1;
+#endif
+}
+
+__inline static void _shutdown_timer(_timer *ptimer)
+{
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0))
+	timer_shutdown_sync(&ptimer->timer);
+#else
+	u8 cancelled;
+
+	_cancel_timer(ptimer, &cancelled);
+#endif
+}
