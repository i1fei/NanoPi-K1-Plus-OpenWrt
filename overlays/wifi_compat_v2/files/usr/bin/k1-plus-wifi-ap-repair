#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = "friendlyelec,nanopi-k1-plus" ] || exit 0
[ -f /etc/modules.d/rtl8189es ] || exit 0
[ -x /usr/sbin/hostapd ] || exit 0

log() {
	logger -t k1-plus-wifi-ap-repair "$*"
}

ssid="$(uci -q get wireless.default_radio0.ssid || echo NanoPi-K1-Plus)"

ap_visible() {
	iwinfo 2>/dev/null | grep -q "ESSID: \"$ssid\""
}

has_phy() {
	[ -d /sys/class/ieee80211/phy0 ] || [ "$(ls /sys/class/ieee80211 2>/dev/null | wc -l)" = 1 ]
}

try=1
while [ "$try" -le 6 ]; do
	uci -q set wireless.radio0.disabled='0'
	uci -q set wireless.default_radio0.disabled='0'
	uci -q commit wireless

	if ap_visible; then
		log "AP visible: $ssid"
		exit 0
	fi

	if ! has_phy; then
		log "try $try: no ieee80211 phy yet"
		sleep 10
		try=$((try + 1))
		continue
	fi

	log "try $try: AP not visible, restarting radio0"
	wifi down radio0 >/dev/null 2>&1 || true
	sleep 2
	if [ "$try" -ge 4 ]; then
		killall hostapd >/dev/null 2>&1 || true
		sleep 1
	fi
	wifi up radio0 >/dev/null 2>&1 || wifi reload >/dev/null 2>&1 || true
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	sleep 12
	try=$((try + 1))
done

log "AP still not visible after bounded retries"
exit 0
