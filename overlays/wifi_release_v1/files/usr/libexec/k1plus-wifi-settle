#!/bin/sh

log=/root/wifi-diag/settle.log
marker=/tmp/k1plus-wifi-settle-reload
mkdir -p /root/wifi-diag 2>/dev/null || exit 1

up() { cut -d. -f1 /proc/uptime 2>/dev/null; }
event() {
	printf '%s up=%ss %s\n' "$(date '+%F %T')" "$(up)" "$*" >> "$log"
}
disabled() {
	uci show wireless 2>/dev/null | grep -q "\.disabled='1'$"
}
ap_present() {
	local ap_interface
	ap_interface=$(iw dev 2>/dev/null | awk '$1 == "Interface" { name=$2 } $1 == "type" && $2 == "AP" { print name; exit }')
	[ -n "$ap_interface" ] || return 1
	iw dev "$ap_interface" info 2>/dev/null | awk '$1 == "type" && $2 == "AP" { found=1 } END { exit !found }'
}

event 'settle: started'
elapsed=0
stable_since=
last_cksum=
while [ "$elapsed" -lt 120 ]; do
	if disabled; then
		event 'settle: administrator disabled wireless; exiting'
		exit 0
	fi
	if ap_present; then
		event "settle: AP present at up=$(up)s"
		exit 0
	fi
	checksum=$(cksum /etc/config/wireless 2>/dev/null | awk '{print $1 ":" $2}')
	if [ -n "$checksum" ] && [ "$checksum" = "$last_cksum" ]; then
		[ -n "$stable_since" ] || stable_since=$(up)
	else
		last_cksum=$checksum
		stable_since=$(up)
	fi
	if [ -d /sys/class/ieee80211/phy0 ] && [ "$(up)" -ge 35 ] && [ -n "$stable_since" ] && [ $(( $(up) - stable_since )) -ge 3 ]; then
		if [ -e "$marker" ]; then
			event 'settle: reload already attempted this boot; exiting'
			exit 0
		fi
		: > "$marker" || exit 1
		reload_start=$(up)
		wifi reload
		reload_rc=$?
		event "settle: wifi reload at up=${reload_start}s rc=$reload_rc"
		post_elapsed=0
		while [ "$post_elapsed" -le 30 ]; do
			if ap_present; then
				event "settle: AP appeared ${post_elapsed}s after reload at up=$(up)s"
				exit 0
			fi
			[ "$post_elapsed" -ge 30 ] && break
			sleep 2
			post_elapsed=$((post_elapsed + 2))
		done
		event 'settle: AP still missing'
		exit 0
	fi
	sleep 2
	elapsed=$((elapsed + 2))
done
event 'settle: timeout waiting for stable configuration and phy0'
exit 0
