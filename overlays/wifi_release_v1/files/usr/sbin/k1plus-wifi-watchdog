#!/bin/sh

. /lib/functions.sh

tag=k1plus-wifi-watchdog
failures=0
stage=0
last_recovery=0
recovery_count=0
health_checks=0
last_health_signature=

diag_base=/root/wifi-diag
diag_collect=/usr/libexec/wifi-diag-collect.sh
diag_mode_file=/etc/wifi-watchdog.mode

mkdir -p "$diag_base" 2>/dev/null || true

watchdog_mode() {
	case "$(cat "$diag_mode_file" 2>/dev/null)" in
		observe) printf '%s\n' observe ;;
		*) printf '%s\n' recover ;;
	esac
}

event() {
	message=$*
	logger -t "$tag" "$message"
	printf '%s up=%ss mode=%s %s\n' "$(date '+%F %T')" "$(cut -d. -f1 /proc/uptime)" "$(watchdog_mode)" "$message" >> "$diag_base/watchdog.log" 2>/dev/null || true
}

[ -e /etc/wifi-release-done ] || {
	event 'provisioning incomplete; WiFi recovery is disabled'
	exit 0
}

[ -e /root/WATCHDOG-DISABLED.txt ] && {
	event 'automatic recovery disabled by watchdog limit'
	exit 0
}

config_load k1plus_watchdog
config_get interval wifi interval
config_get threshold wifi failure_threshold
config_get command_timeout wifi command_timeout
config_get reload_grace wifi reload_grace
config_get recovery_window wifi recovery_window
config_get max_recoveries wifi max_recoveries
config_get reboot_cooldown wifi reboot_cooldown
for value in "$interval" "$threshold" "$command_timeout" "$reload_grace" "$recovery_window" "$max_recoveries" "$reboot_cooldown"; do
	case "$value" in ''|*[!0-9]*) event 'invalid watchdog configuration'; exit 1;; esac
done
event "START interval=$interval threshold=$threshold radio=dynamic iface=kernel-ap+netifd"

kernel_ap_healthy() {
	ap_interface=$(iw dev 2>/dev/null | awk '
		$1 == "Interface" { name=$2 }
		$1 == "type" && $2 == "AP" { if (name != "") { print name; exit } }')
	[ -n "$ap_interface" ]
	ap_discovery_rc=$?
	if [ "$ap_discovery_rc" -eq 0 ]; then
		iw dev "$ap_interface" info 2>/dev/null | awk '$1 == "type" && $2 == "AP" { found=1 } END { exit !found }'
		ap_info_rc=$?
	else
		ap_info_rc=1
	fi
	[ "$ap_discovery_rc" -eq 0 ] && [ "$ap_info_rc" -eq 0 ]
}

netifd_ap_healthy() {
	ubus_rc=1
	ubus_up_rc=1
	ubus_ifname_rc=1
	status=$(ubus call network.wireless status 2>/dev/null) || return 1
	ubus_rc=0
	printf '%s\n' "$status" | grep -q '"up"[[:space:]]*:[[:space:]]*true'
	ubus_up_rc=$?
	printf '%s\n' "$status" | grep -q '"ifname"[[:space:]]*:'
	ubus_ifname_rc=$?
	[ "$ubus_up_rc" -eq 0 ] && [ "$ubus_ifname_rc" -eq 0 ]
}

healthy() {
	pidof hostapd >/dev/null 2>&1
	hostapd_rc=$?
	kernel_ap_healthy
	kernel_rc=$?
	netifd_ap_healthy
	netifd_rc=$?
	[ "$hostapd_rc" -eq 0 ] && [ "$kernel_rc" -eq 0 ] && [ "$netifd_rc" -eq 0 ] && [ "$ubus_rc" -eq 0 ] && [ "$ubus_up_rc" -eq 0 ] && [ "$ubus_ifname_rc" -eq 0 ]
	healthy_rc=$?
	uci show wireless 2>/dev/null | grep -q "\.disabled='1'$"
	admin_disabled_rc=$?
	health_checks=$((health_checks + 1))
	health_signature="hostapd_rc=$hostapd_rc ap_discovery_rc=$ap_discovery_rc ap_info_rc=$ap_info_rc ubus_rc=$ubus_rc ubus_up_rc=$ubus_up_rc ubus_ifname_rc=$ubus_ifname_rc admin_disabled_rc=$admin_disabled_rc healthy_rc=$healthy_rc"
	if [ "$health_signature" != "$last_health_signature" ] || [ $((health_checks % 10)) -eq 0 ]; then
		printf '%s up=%ss mode=%s HEALTH %s\n' "$(date '+%F %T')" "$(cut -d. -f1 /proc/uptime)" "$(watchdog_mode)" "$health_signature" >> "$diag_base/watchdog.log" 2>/dev/null || true
		last_health_signature=$health_signature
	fi
	return "$healthy_rc"
}

administrator_disabled() {
	uci show wireless 2>/dev/null | grep -q "\.disabled='1'$"
}

allow_recovery() {
	now=$(date +%s)
	if [ "$last_recovery" -eq 0 ] || [ "$now" -ge $((last_recovery + recovery_window)) ]; then
		recovery_count=0
	fi
	recovery_count=$((recovery_count + 1))
	last_recovery=$now
	if [ "$recovery_count" -gt "$max_recoveries" ]; then
		event "recovery limit exceeded (${max_recoveries}/${recovery_window}s); automatic recovery disabled"
		printf '%s\n' 'Automatic WiFi recovery disabled after repeated escalations.' > /root/WATCHDOG-DISABLED.txt
		return 1
	fi
	return 0
}

run_bounded() {
	"$@" &
	pid=$!
	elapsed=0
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$elapsed" -ge "$command_timeout" ]; then
			event "command timed out after ${command_timeout}s: $*"
			return 124
		fi
		sleep 1
		elapsed=$((elapsed + 1))
	done
	wait "$pid"
}

reboot_after_timeout() {
	event 'recovery command is still blocked; rebooting and relying on the hardware watchdog if shutdown stalls'
	sync
	reboot
	exit 0
}

allow_reboot() {
	stamp_file=/etc/k1plus-watchdog-last-reboot
	now=$(date +%s)
	last=$(cat "$stamp_file" 2>/dev/null || echo 0)
	case "$last" in ''|*[!0-9]*) last=0;; esac
	if [ "$last" -gt 0 ] && [ "$now" -lt $((last + reboot_cooldown)) ]; then
		event "reboot cooldown active; refusing watchdog reboot for $((last + reboot_cooldown - now))s"
		printf '%s\n' 'Automatic watchdog reboot is rate-limited to once per hour.' > /root/WATCHDOG-DISABLED.txt
		return 1
	fi
	printf '%s\n' "$now" > "$stamp_file" || {
		event 'could not persist watchdog reboot timestamp; refusing reboot'
		return 1
	}
	return 0
}

reload_driver() {
	run_bounded /sbin/kmodloader -r rtl8189es
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	run_bounded /sbin/kmodloader rtl8189es
	result=$?
	[ "$result" -eq 0 ] || return "$result"
	run_bounded wifi reload
}

while :; do
	sleep "$interval"
	if administrator_disabled; then
		[ "$failures" -eq 0 ] || event 'administrator disabled wireless; recovery suppressed'
		failures=0
		stage=0
		continue
	fi
	if healthy; then
		[ "$failures" -eq 0 ] || event 'health recovered'
		failures=0
		stage=0
		continue
	fi

	failures=$((failures + 1))
	event "health failure $failures/$threshold at recovery stage $stage"
	[ "$failures" -lt "$threshold" ] && continue
	failures=0

	if [ "$(watchdog_mode)" = observe ]; then
		event 'THRESHOLD-REACHED observe mode; collecting diagnostics and suppressing recovery'
		"$diag_collect" observe "fails=$threshold stage=$stage"
		event "collect tag=observe rc=$?"
		continue
	fi
	if [ "$stage" -eq 0 ]; then
		"$diag_collect" pre-reload "fails=$threshold stage=$stage"
		event "collect tag=pre-reload rc=$?"
	fi

	case "$stage" in
		0)
			allow_recovery || exit 0
			event 'recovery stage 1: wifi reload'
			run_bounded wifi reload
			result=$?
			[ "$result" -eq 124 ] && reboot_after_timeout
			event "waiting ${reload_grace}s after wifi reload"
			sleep "$reload_grace"
			"$diag_collect" post-reload "stage=1 result=$result"
			event "collect tag=post-reload rc=$?"
			if healthy; then
				event 'wifi reload restored kernel AP, hostapd, and netifd UBus state'
				stage=0
				continue
			fi
			event 'wifi reload did not restore kernel AP and netifd UBus state; no validated non-driver recovery path is available'
			stage=1
			;;
		1)
			allow_recovery || exit 0
			"$diag_collect" pre-driver-reload "fails=$threshold stage=$stage"
			event "collect tag=pre-driver-reload rc=$?"
			event 'recovery stage 2: driver reload'
			reload_driver
			result=$?
			[ "$result" -eq 124 ] && reboot_after_timeout
			[ "$result" -eq 0 ] || event 'driver reload failed'
			event "waiting ${reload_grace}s after driver reload"
			sleep "$reload_grace"
			"$diag_collect" post-reload "stage=2 result=$result"
			event "collect tag=post-reload rc=$?"
			if healthy; then
				event 'driver reload restored kernel AP, hostapd, and netifd UBus state'
				stage=0
				continue
			fi
			event 'driver reload did not restore kernel AP and netifd UBus state'
			stage=2
			;;
		*)
			allow_recovery || exit 0
			"$diag_collect" pre-reboot "stage=$stage"
			event "collect tag=pre-reboot rc=$?"
			if healthy; then
				failures=0
				stage=0
				event 'stage3 aborted: healthy on recheck'
				continue
			fi
			allow_reboot || exit 0
			event 'recovery stage 3: reboot'
			sync
			reboot
			exit 0
			;;
	esac
done
