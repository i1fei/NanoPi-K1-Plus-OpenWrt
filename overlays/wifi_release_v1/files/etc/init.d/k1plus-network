#!/bin/sh /etc/rc.common

START=18
STOP=89
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/k1plus-network-mode
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger k1plus_network
}
